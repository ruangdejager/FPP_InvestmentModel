# Where the SQLite database, uploads and backups live.
# Locally this defaults to ./data; on Railway it is the volume mount path.
DATA_DIR=./data

# The single port the API and the built frontend are served from.
PORT=3000

NODE_ENV=development

# Only read by the seed script, and only when creating accounts that do not yet
# exist. Leave it unset and the seed generates a password per director and
# prints it once.
# SEED_PASSWORD=
