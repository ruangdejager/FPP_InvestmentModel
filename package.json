{
  "name": "five-peaks-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @fp/engine && npm run build -w @fp/shared && npm run build -w @fp/web && npm run build -w @fp/server",
    "dev": "npm run dev -w @fp/server",
    "dev:web": "npm run dev -w @fp/web",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/engine packages/shared apps/server apps/web",
    "db:generate": "npm run db:generate -w @fp/server",
    "db:migrate": "npm run db:migrate -w @fp/server",
    "db:seed": "npm run db:seed -w @fp/server",
    "reset-password": "npm run reset-password -w @fp/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
